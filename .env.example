# Linggo — sunucu ayarları
# Bu dosyayı .env olarak kopyala ve değerleri doldur.

NODE_ENV=production
PORT=5173
HOST=0.0.0.0

# Uygulamanın dışarıdan erişilen adresi (e-postalardaki bağlantılar için)
APP_URL=https://pratilange.com

# Uzun ve rastgele bir değer (doğrulama kodlarını imzalamak için). Örn: openssl rand -hex 32
APP_SECRET=

# Veritabanı dosyası (SQLite). Yedeklemeyi unutma!
DB_PATH=data/pratilange.db

# Bu e-postalarla kayıt olan / giriş yapan hesaplar otomatik yönetici olur (virgülle ayır)
ADMIN_EMAILS=huseyinaydinwork@gmail.com

# HTTPS arkasında (nginx / Caddy / Cloudflare) çalışırken 1 yap
TRUST_PROXY=1
COOKIE_SECURE=1

# E-posta (SMTP) — doğrulama ve şifre sıfırlama kodları için zorunlu
# Örnekler: Brevo (smtp-relay.brevo.com:587), Resend (smtp.resend.com:465), Gmail (smtp.gmail.com:465 + uygulama şifresi)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Linggo <no-reply@pratilange.com>

# Yüksek kaliteli seslendirme (Pip'in Türkçe sesi + ABD/UK İngilizce). Biri yeterli; yoksa cihaz sesleri kullanılır.
# Azure (önerilen, Türkçe "tr-TR-EmelNeural" çok doğal; ayda 500 bin karakter ücretsiz):
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Google Cloud Text-to-Speech:
GOOGLE_TTS_KEY=
# ElevenLabs (ses kimliklerini panelde Ses sayfasından gir):
ELEVENLABS_API_KEY=

# Online ödeme sağlayıcısı bağlandığında (iyzico / stripe). Boşken siparişler WhatsApp ile tamamlanır.
PAYMENT_PROVIDER=
